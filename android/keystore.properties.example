# Salin file ini menjadi "keystore.properties" (tanpa .example) di folder yang sama,
# lalu isi dengan data keystore Anda yang sebenarnya. File "keystore.properties" sudah
# di-gitignore, jadi TIDAK akan pernah ter-commit ke repository.
#
# storeFile: path ke file .jks/.keystore Anda. Bisa path relatif dari folder android/app/,
#            atau path absolut (mis. copy-kan dulu file keystore lama Anda ke android/app/).
storeFile=nama-file-keystore-anda.jks
storePassword=isi_password_keystore_disini
keyAlias=isi_alias_key_disini
keyPassword=isi_password_key_disini
